# Copy to .env and fill secrets. Never commit real .env.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ksocical
PORT=4000

JWT_ACCESS_SECRET=change_me_access
JWT_SOCKET_SECRET=change_me_socket

# Frontends allowed to call this API
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# Global rate limit (ms window / max requests)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=150

# Email (OTP, alerts). Brevo is used when both BREVO_* are set, otherwise Resend.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=you@gmail.com   # must be a verified sender in Brevo
# BREVO_SENDER_NAME=Ksocial
# RESEND_API_KEY=
# MAIL_FROM=Ksocial <onboarding@resend.dev>

# Optional: AI (Gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_CHAT_THROTTLE_LIMIT=20
#
# Local Windows only (antivirus SSL scan). Do NOT set on Render:
# ALLOW_INSECURE_TLS=1
