{
  "name": "ksocial-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev": "concurrently -n web,api,admin -c blue,green,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:admin\"",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "build": "npm run build:web && npm run build:api",
    "lint:web": "npm run lint -w apps/web",
    "lint:api": "npm run lint -w apps/api",
    "lint:admin": "npm run lint -w apps/admin",
    "lint": "npm run lint:web && npm run lint:api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
